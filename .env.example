NAHALLM_REQUEST_TIMEOUT_SECONDS=45
NAHALLM_MAX_RETRIES_PER_PROVIDER=1
NAHALLM_CIRCUIT_FAILURE_THRESHOLD=3
NAHALLM_CIRCUIT_COOLDOWN_SECONDS=30

